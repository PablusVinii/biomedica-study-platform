datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("STUDENT") // "STUDENT" | "ADMIN"
  createdAt DateTime @default(now())

  progresses    Progress[]
  notes         TopicNote[]
  blockNotes    BlockNote[]
  courseAccess  CourseAccess[]
}

model CoursePart {
  id          Int           @id @default(autoincrement())
  title       String
  icon        String        @default("Activity")
  order       Int           @default(0)
  blocks      CourseBlock[]
  accesses    CourseAccess[]
  createdAt   DateTime      @default(now())
}

model CourseBlock {
  id          Int           @id @default(autoincrement())
  title       String
  content     String?
  partId      Int
  part        CoursePart    @relation(fields: [partId], references: [id])
  topics      CourseTopic[]
  highlights  String?       // JSON string array
  bibliography String?      // JSON string array
  order       Int           @default(0)
  blockNotes  BlockNote[]
}

model CourseTopic {
  id          String        @id @default(uuid())
  title       String
  content     String?
  videoUrl    String?       // Link do YouTube
  blockId     Int
  block       CourseBlock   @relation(fields: [blockId], references: [id])
  progresses  Progress[]
  topicNotes  TopicNote[]
  order       Int           @default(0)
}

model BlockNote {
  id        String   @id @default(uuid())
  userId    String
  blockId   Int
  title     String?
  content   String
  tags      String?
  user      User     @relation(fields: [userId], references: [id])
  block     CourseBlock @relation(fields: [blockId], references: [id])
  updatedAt DateTime @updatedAt

  @@unique([userId, blockId])
}

model TopicNote {
  id          String   @id @default(uuid())
  userId      String
  topicId     String
  notebookUrl String?
  user        User     @relation(fields: [userId], references: [id])
  topic       CourseTopic @relation(fields: [topicId], references: [id])
  updatedAt   DateTime @updatedAt

  @@unique([userId, topicId])
}

model Progress {
  id        String   @id @default(uuid())
  userId    String
  topicId   String
  completed Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id])
  topic     CourseTopic @relation(fields: [topicId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, topicId])
}

model CourseAccess {
  id        String   @id @default(uuid())
  userId    String
  partId    Int
  user      User     @relation(fields: [userId], references: [id])
  part      CoursePart @relation(fields: [partId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, partId])
}
